---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ScholarlyHeader from '../../components/ScholarlyHeader.astro';

const projects = (await getCollection('projects')).sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return (a.data.order ?? 99) - (b.data.order ?? 99);
});

const allLogs = await getCollection('projectLogs');
const allDives = await getCollection('deepDives');

const countsFor = (name) => ({
  logs: allLogs.filter(l => l.data.project === name).length,
  dives: allDives.filter(d => d.data.project === name).length,
});

// Accent classes are written as full literal strings so Tailwind never purges them.
const ACCENTS = {
  blue:    { text: 'text-blue-400',    bar: 'bg-blue-500/50',    hover: 'group-hover:text-blue-400' },
  emerald: { text: 'text-emerald-400', bar: 'bg-emerald-500/50', hover: 'group-hover:text-emerald-400' },
  violet:  { text: 'text-violet-400',  bar: 'bg-violet-500/50',  hover: 'group-hover:text-violet-400' },
  amber:   { text: 'text-amber-400',   bar: 'bg-amber-500/50',   hover: 'group-hover:text-amber-400' },
};

// Edit these to control the contact block. Leave a value empty to hide that link.
const CONTACT = {
  email: "armstrongolusoji9@gmail.com",
  github: "",   // e.g. "https://github.com/your-handle"
  twitter: "",  // e.g. "https://x.com/your-handle"
};
---

<Layout
  title="Work | Armstrong Olusoji"
  description="Selected work by Armstrong Olusoji — Applied AI engineer building infrastructure for domain-specific AI co-pilots. Poysis, Product Scout, Simasia."
>
  <div class="min-h-screen bg-zinc-950 text-zinc-300 selection:bg-blue-500/30 pb-24">
    <ScholarlyHeader />

    <main class="max-w-3xl mx-auto px-6">
      <!-- Hero -->
      <header class="mb-20">
        <div class="text-[10px] font-sans font-bold uppercase tracking-[0.3em] text-zinc-600 mb-6">
          Selected Work
        </div>
        <h1 class="text-4xl md:text-6xl font-serif font-bold text-white mb-6 leading-[1.05]">
          Armstrong Olusoji
        </h1>
        <p class="text-xl md:text-2xl text-zinc-300 font-serif italic leading-relaxed mb-8 max-w-2xl">
          Applied AI engineer building the infrastructure for domain-specific AI co-pilots.
        </p>
        <div class="text-zinc-400 text-lg leading-relaxed space-y-4 max-w-2xl mb-10">
          <p>
            I design and ship systems that turn deep domain knowledge into intelligent products —
            from the primitives layer up. Below is the work: platforms, shipped tools, and the
            engineering breakdowns behind them.
          </p>
        </div>

        <!-- Availability + contact -->
        <div class="flex flex-col gap-4 border border-zinc-900 bg-zinc-900/20 p-6">
          <div class="flex items-center gap-3">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500/60 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span class="text-sm text-zinc-300 font-sans">
              Open to select consulting &amp; build engagements in Applied AI.
            </span>
          </div>
          <div class="flex flex-wrap gap-3 text-xs font-sans">
            <a href={`mailto:${CONTACT.email}`} class="px-4 py-2 bg-white text-zinc-950 font-bold uppercase tracking-wider hover:bg-zinc-200 transition-colors">
              Get in touch
            </a>
            {CONTACT.github && (
              <a href={CONTACT.github} class="px-4 py-2 border border-zinc-800 text-zinc-400 uppercase tracking-wider hover:text-white hover:border-zinc-600 transition-colors">GitHub</a>
            )}
            {CONTACT.twitter && (
              <a href={CONTACT.twitter} class="px-4 py-2 border border-zinc-800 text-zinc-400 uppercase tracking-wider hover:text-white hover:border-zinc-600 transition-colors">X / Twitter</a>
            )}
          </div>
        </div>
      </header>

      <div class="scholarly-hr"></div>

      <!-- Project grid -->
      <section class="mt-16">
        <h2 class="text-[10px] font-sans font-bold uppercase tracking-[0.3em] text-zinc-600 mb-10 flex items-center gap-4">
          Projects <span class="h-px flex-1 bg-zinc-900"></span>
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {projects.map(project => {
            const a = ACCENTS[project.data.accent ?? 'emerald'];
            const counts = countsFor(project.data.name);
            return (
              <a
                href={`/projects/${project.slug}`}
                class:list={[
                  "group relative block border border-zinc-900 hover:border-zinc-700 bg-zinc-900/20 hover:bg-zinc-900/40 transition-all p-8 overflow-hidden",
                  project.data.featured && "md:col-span-2"
                ]}
              >
                <span class={`absolute top-0 left-0 h-px w-full ${a.bar}`}></span>

                <div class="flex items-center justify-between mb-5">
                  {project.data.status && (
                    <span class={`text-[10px] font-sans font-bold uppercase tracking-[0.2em] ${a.text}`}>
                      {project.data.status}
                    </span>
                  )}
                  <span class="text-xs font-mono text-zinc-600">{project.data.year}</span>
                </div>

                <h3 class={`text-2xl md:text-3xl font-serif font-bold text-white mb-3 leading-tight ${a.hover} transition-colors`}>
                  {project.data.name}
                </h3>
                <p class="text-zinc-300 italic font-serif leading-relaxed mb-5 text-lg">
                  {project.data.tagline}
                </p>
                <p class="text-sm text-zinc-500 leading-relaxed mb-6 max-w-2xl">
                  {project.data.summary}
                </p>

                {project.data.stack && (
                  <div class="flex flex-wrap gap-2 mb-6">
                    {project.data.stack.map(tech => (
                      <span class="px-2 py-1 bg-zinc-900 border border-zinc-800 text-[10px] font-mono uppercase tracking-tighter text-zinc-500 group-hover:text-zinc-400 transition-colors">
                        {tech}
                      </span>
                    ))}
                  </div>
                )}

                <div class="flex items-center gap-4 text-[10px] font-mono uppercase tracking-wider text-zinc-600 pt-4 border-t border-zinc-900">
                  {project.data.role && <span class="text-zinc-500">{project.data.role}</span>}
                  <span class="ml-auto flex items-center gap-3">
                    {counts.logs > 0 && <span>{counts.logs} log{counts.logs === 1 ? '' : 's'}</span>}
                    {counts.dives > 0 && <span>{counts.dives} deep dive{counts.dives === 1 ? '' : 's'}</span>}
                    <span class={`${a.text} font-bold`}>View →</span>
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      </section>

      <div class="scholarly-hr mt-20"></div>

      <footer class="text-zinc-600 text-sm italic py-10 max-w-lg">
        "I'm not trying to predict the future of technology. I'm trying to help shape the kind of builders and systems that should exist in it."
      </footer>
    </main>
  </div>
</Layout>
