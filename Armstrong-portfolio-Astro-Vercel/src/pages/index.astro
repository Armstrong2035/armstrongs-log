---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { projects, projectLogs, essays, deepDives, formatDate } from "../lib/content";
const recent = [...projectLogs, ...essays].sort((a,b)=>b.date.localeCompare(a.date)).slice(0,8);
---
<BaseLayout><main><Nav />
  <section class="hero shell"><p class="kicker">Applied AI engineer · Builder · Writer</p><h1>I turn deep domain knowledge into <em>intelligent products.</em></h1><div class="heroBottom"><p>Hi, I'm Armstrong. I build software that helps domain experts encode their knowledge into useful AI products.</p><div class="heroActions"><a class="button dark" href="#work">Explore my work ↓</a><a class="textLink" href="mailto:armstrongolusoji9@gmail.com">Discuss a project ↗</a></div></div><div class="heroMark" aria-hidden="true">A<span>/</span>O</div></section>
  <section class="thesis"><div class="shell thesisGrid"><p class="sectionLabel">01 / The thesis</p><div><h2>The internet is moving from the creator economy to the <em>curator economy.</em></h2><p>The best digital products of the next decade will help users find and act on information specific to their context. AI co-pilots are the interface. Domain experts will make it happen by encoding their knowledge into products that drive niche results.</p></div><p class="marginNote">That is the future I am betting the next decade of my life on.</p></div></section>
  <section class="work shell" id="work"><header class="sectionHead"><div><p class="sectionLabel">02 / Active projects</p><h2>Products built around <em>real expertise.</em></h2></div><a class="textLink" href="/projects">View all projects ↗</a></header><div class="projectGrid">{projects.map((project,index)=><a class={`projectCard tone-${index+1}`} href={`/projects/${project.slug}`}><div class="cardTop"><span>{String(index+1).padStart(2,"0")}</span><span class="status">{String(project.meta.status)} · {String(project.meta.year)}</span></div><p class="eyebrow">{String(project.meta.role)}</p><h3>{project.title}</h3><p>{project.description}</p><div class="tags">{((project.meta.stack as string[])||[]).map(tag=><span>{tag}</span>)}</div><div class="cardLink">View project <span>↗</span></div></a>)}</div></section>
  <section class="technicalBand"><div class="shell technicalGrid"><div><p class="sectionLabel light">03 / Under the hood</p><h2>Engineering is philosophy turned into <em>proof of work.</em></h2></div><div class="diveList">{deepDives.map(dive=><a href={`/technical/${dive.slug}`}><span class="lambda">λ</span><div><p>{((dive.meta.stack as string[])||[]).join(" · ")}</p><h3>{dive.title}</h3><small>{String(dive.meta.difficulty)} · {formatDate(dive.date)}</small></div><b>↗</b></a>)}<a class="allDives" href="/technical">Browse technical deep dives →</a></div></div></section>
  <section class="writing shell"><header class="sectionHead"><div><p class="sectionLabel">04 / Essays and project logs</p><h2>Thinking in public.</h2></div><a class="textLink" href="/writing">Read the complete archive ↗</a></header><div class="essayList">{recent.map((item,i)=><a href={item.type==="projectLog"?`/writing/project/${item.slug}`:`/writing/${item.slug}`}><span class="essayNo">{String(i+1).padStart(2,"0")}</span><h3>{item.title}</h3><p>{item.type==="projectLog"?String(item.meta.project):"Essay"}</p><time>{formatDate(item.date)}</time><b>↗</b></a>)}</div></section>
  <section class="contact"><div class="shell contactInner"><p class="sectionLabel light">05 / Let's work</p><h2>Have a hard AI problem worth <em>solving well?</em></h2><p>I am open to select consulting and build engagements in Applied AI.</p><a class="button paper" href="mailto:armstrongolusoji9@gmail.com">Tell me what you are building ↗</a></div></section><Footer />
</main></BaseLayout>
