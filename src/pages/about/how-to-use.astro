---
import BaseLayout from "../../layouts/BaseLayout.astro"; import Nav from "../../components/Nav.astro"; import Footer from "../../components/Footer.astro"; import Markdown from "../../components/Markdown.astro"; import { systemPages } from "../../lib/content"; const page=systemPages.find(item=>item.slug==="how-to-use");
---
<BaseLayout title={`${page?.title || "How to use"} | Armstrong Olusoji`}><main><Nav/><section class="articleHero shell"><p class="sectionLabel">About this site</p><h1>{page?.title}</h1><p>{page?.description}</p></section><article class="articleBody shell">{page&&<Markdown content={page.body}/>}</article><Footer/></main></BaseLayout>
