---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Nav from "../../../components/Nav.astro";
import Footer from "../../../components/Footer.astro";
import { writingGroups, formatDate } from "../../../lib/content";

export function getStaticPaths() {
  const slugify = (value: string) => value.toLowerCase().replace(/&/g, "and").replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
  return Object.entries(writingGroups).map(([group, items]) => ({ params: { slug: slugify(group) }, props: { group, items } }));
}
const { group, items } = Astro.props;
---
<BaseLayout title={`${group} | Armstrong Olusoji`}>
  <main>
    <Nav />
    <section class="innerHero shell">
      <p class="sectionLabel">Essay collection</p>
      <h1>{group}</h1>
      <p>{items.length} complete essays from Armstrong's original archive.</p>
    </section>
    <section class="pageBody shell seriesList">
      {items.map((item, index) => <a href={`/writing/${item.slug}`}><span>{String(index + 1).padStart(2, "0")}</span><div><h2>{item.title}</h2><p>{item.description}</p><small>{formatDate(item.date)}</small></div><b>↗</b></a>)}
    </section>
    <Footer />
  </main>
</BaseLayout>
